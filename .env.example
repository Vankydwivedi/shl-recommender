# Choose ONE LLM provider and set the corresponding key.
# If LLM_PROVIDER is not set, the first available key is used automatically.

# Option A — Google Gemini (free tier: 15 RPM, generous daily quota)
GOOGLE_API_KEY=your_google_api_key_here
LLM_PROVIDER=google

# Option B — Groq (free tier: very fast inference)
# GROQ_API_KEY=your_groq_api_key_here
# LLM_PROVIDER=groq
